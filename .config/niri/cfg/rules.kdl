    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }



    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

layer-rule {
  match namespace="^noctalia-(-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
  }
}
layer-rule {
	match namespace="^noctalia-(bar)"
	background-effect {
		blur false
	}
}
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}



window-rule {
	focus-ring {
		off
	}

	opacity 0.9
	background-effect {
		blur true
		xray true
	}
}


blur {
    	passes 3
    	offset 3
    	noise 0.01
    	saturation 1
}


window-rule {
    match app-id="chromium" title="YouTube" 
    match app-id="chromium" title="JioHotstar"
    opacity 1.0
    background-effect {
      blur false
      xray false
    }
}


window-rule {
    exclude app-id="kitty"
    open-maximized true
    open-maximized-to-edges false
}
 


debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}


layer-rule {
  match namespace="^noctalia-wallpaper"
  place-within-backdrop true
}



window-rule {
  match app-id="org.gnome.Nautilus"
  match app-id="org.gnome.Loupe"
  open-floating true
}

